<response>
<error>0</error>
<rss version="0.91">
<channel>
<!-- BEGIN entry -->
<title>{entry_title}</title>
<link>{entry_permalink}</link>
<description>{entry_excerpt}</description>
<!-- END entry -->
<!-- BEGIN trackback_area -->
<!-- BEGIN trackback -->
<item>
<title>{trackback_title_only}</title>
<link>{trackback_url_only}</link>
<description>{trackback_excerpt}</description>
</item>
<!-- END trackback -->
<!-- END trackback_area -->
</channel>
</rss>
</response>
