<?xml version="1.0" encoding="{site_encoding}"?>
<blog>
<!-- BEGIN title -->
<name>{blog_name_only}</name> 
<description><![CDATA[{blog_description}]]></description>
<!-- END title -->
<entries>
<!-- BEGIN entry -->
<entry>
<title>{entry_title}</title>
<author>{user_disp_name}</author>
<category>{category_disp_name}</category>
<status>{export_entry_status}</status>
<allowcomments>{export_entry_allowcomments}</allowcomments>
<allowpings>{export_entry_allowpings}</allowpings>
<convertbreaks>{export_entry_format}</convertbreaks>
<date>{export_entry_date}</date>
<filename><![CDATA[{export_filename}]]></filename>
<excerpt><![CDATA[{entry_excerpt}]]></excerpt>
<keyword><![CDATA[{entry_keyword}]]></keyword>
<description><![CDATA[{entry_description}]]></description>
<sequel><![CDATA[{entry_sequel}]]></sequel>
<comments>{export_entry_comments}</comments>
<trackbacks>{export_entry_pings}</trackbacks>
</entry>
<!-- END entry -->
</entries>
</blog>
