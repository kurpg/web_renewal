{comment_num} | {trackback_num}&lt;/div&gt;%n&lt;/div&gt;&lt;!--_end_entry_--&gt;%n{trackback_auto_discovery}%n&lt;!-- END entry --&gt;%n&lt;!-- BEGIN comment_area --&gt;%n&lt;div class=&quot;comment&quot;&gt;%n&lt;h3 id=&quot;comments&quot;&gt;Comments&lt;/h3&gt;%n&lt;!-- BEGIN comment --&gt;%n&lt;dl class=&quot;body&quot;&gt;%n&lt;dt&gt;{comment_name} | {comment_time}&lt;/dt&gt;%n&lt;dd&gt;{comment_description}&lt;/dd&gt;%n&lt;/dl&gt;%n&lt;!-- END comment --&gt;%n&lt;form action=&quot;{site_cgi}&quot; method=&quot;post&quot;&gt;%n&lt;h4&gt;Comment Form&lt;/h4&gt;%n&lt;dl&gt;%n&lt;dt&gt;&lt;label for=&quot;name&quot; id=&quot;labelname&quot;&gt;name:&lt;/label&gt;&lt;/dt&gt;%n&lt;dd&gt;%n&lt;input type=&quot;text&quot; tabindex=&quot;1&quot; name=&quot;name&quot; id=&quot;name&quot; value=&quot;{cookie_name}&quot; size=&quot;20&quot; /&gt;%n&lt;label for=&quot;set_cookie&quot;&gt;Cookie&lt;/label&gt;&lt;input type=&quot;checkbox&quot; tabindex=&quot;2&quot; name=&quot;set_cookie&quot; value=&quot;1&quot; id=&quot;set_cookie&quot;&gt;%n&lt;/dd&gt;%n&lt;dt&gt;&lt;label for=&quot;email&quot; id=&quot;labelemail&quot;&gt;email:&lt;/label&gt;&lt;/dt&gt;%n&lt;dd&gt;&lt;input type=&quot;text&quot; tabindex=&quot;3&quot; name=&quot;email&quot; id=&quot;email&quot; value=&quot;{cookie_email}&quot; size=&quot;30&quot; /&gt;&lt;/dd&gt;%n&lt;dt&gt;&lt;label for=&quot;url&quot; id=&quot;labelurl&quot;&gt;url:&lt;/label&gt;&lt;/dt&gt;%n&lt;dd&gt;&lt;input type=&quot;text&quot; tabindex=&quot;4&quot; name=&quot;url&quot; id=&quot;url&quot; value=&quot;{cookie_url}&quot; size=&quot;30&quot; /&gt;&lt;/dd&gt;%n&lt;dt&gt;&lt;label for=&quot;description&quot; id=&quot;labeldescription&quot;&gt;comments:&lt;/label&gt;&lt;/dt&gt;%n&lt;dd&gt;&lt;textarea tabindex=&quot;5&quot; id=&quot;description&quot; name=&quot;description&quot; rows=&quot;8&quot; cols=&quot;45&quot;&gt;&lt;/textarea&gt;&lt;/dd&gt;%n&lt;dt&gt;&lt;label for=&quot;description&quot; id=&quot;labelsubmit&quot;&gt;submit&lt;/label&gt;&lt;/dt&gt;%n&lt;dd&gt;%n&lt;input type=&quot;submit&quot; tabindex=&quot;6&quot; id=&quot;submit&quot; value=&quot;submit&quot; /&gt;%n&lt;input type=&quot;reset&quot; tabindex=&quot;7&quot; value=&quot;reset&quot; /&gt;%n&lt;input type=&quot;hidden&quot; name=&quot;entry_id&quot; value=&quot;{entry_id}&quot; /&gt;%n&lt;input type=&quot;hidden&quot; name=&quot;charset&quot; value=&quot;{site_encoding}&quot; /&gt;%n&lt;/dd&gt;%n&lt;/dl&gt;%n&lt;/form&gt;%n&lt;/div&gt;&lt;!--_end_comment_--&gt;%n&lt;!-- END comment_area --&gt;%n&lt;!-- BEGIN trackback_area --&gt;%n&lt;div class=&quot;trackback&quot;&gt;%n&lt;h3 id=&quot;trackback&quot;&gt;Trackbacks&lt;/h3&gt;%n&lt;p class=&quot;link&quot;&gt;Trackback URL : {trackback_url}&lt;/p&gt;%n&lt;!-- BEGIN trackback --&gt;%n&lt;dl class=&quot;body&quot;&gt;%n&lt;dt&gt;{trackback_title} | {trackback_blog_name} | {trackback_time}&lt;/dt&gt;%n&lt;dd&gt;{trackback_excerpt}&lt;/dd&gt;%n&lt;/dl&gt;%n&lt;!-- END trackback --&gt;%n&lt;/div&gt;&lt;!--_end_trackback_--&gt;%n&lt;!-- END trackback_area --&gt;%n&lt;!-- BEGIN profile_area --&gt;%n&lt;div class=&quot;profile&quot;&gt;%n&lt;h2&gt;{profile_name}'s profile&lt;/h2&gt;%n&lt;div class=&quot;profile_body&quot;&gt;{profile_description}&lt;/div&gt;%n&lt;/div&gt;&lt;!--_end_profile_--&gt;%n&lt;!-- END profile_area --&gt;%n&lt;!-- BEGIN page --&gt;%n&lt;div class=&quot;page&quot;&gt;%n{prev_page_link} {page_now}/{page_num} {next_page_link}%n&lt;/div&gt;%n&lt;!-- END page --&gt;%n&lt;/div&gt;&lt;!--_end_contents_--&gt;%n%n&lt;div class=&quot;navigation&quot;&gt;%n&lt;dl class=&quot;calendar&quot;&gt;%n&lt;dt id=&quot;calendarname&quot;&gt;Calendar&lt;/dt&gt;%n&lt;dd id=&quot;calendarlist&quot;&gt;{calendar2}%n&lt;/dd&gt;%n&lt;/dl&gt;%n&lt;!-- BEGIN latest_entry --&gt;%n&lt;dl class=&quot;recententry&quot;&gt;%n&lt;dt id=&quot;newentryname&quot;&gt;Latest Entries&lt;/dt&gt;%n&lt;dd id=&quot;newentrylist&quot;&gt;{latest_entry_list}%n&lt;/dd&gt;%n&lt;/dl&gt;%n&lt;!-- END latest_entry --&gt;%n&lt;!-- BEGIN recent_comment --&gt;%n&lt;dl class=&quot;recentcomment&quot;&gt;%n&lt;dt id=&quot;commentname&quot;&gt;Recent Comments&lt;/dt&gt;%n&lt;dd id=&quot;commentlist&quot;&gt;{recent_comment_list}&lt;/dd&gt;%n&lt;/dl&gt;%n&lt;!-- END recent_comment --&gt;%n&lt;!-- BEGIN recent_trackback --&gt;%n&lt;dl class=&quot;recenttrackback&quot;&gt;%n&lt;dt id=&quot;tbname&quot;&gt;Recent Trackback&lt;/dt&gt;%n&lt;dd id=&quot;tblist&quot;&gt;{recent_trackback_list}&lt;/dd&gt;%n&lt;/dl&gt;%n&lt;!-- END recent_trackback --&gt;%n&lt;!-- BEGIN category --&gt;%n&lt;dl class=&quot;category&quot;&gt;%n&lt;dt id=&quot;categoryname&quot;&gt;Categories&lt;/dt&gt;%n&lt;dd id=&quot;categorylist&quot;&gt;{category_list}&lt;/dd&gt;%n&lt;/dl&gt;%n&lt;!-- END category --&gt;%n&lt;!-- BEGIN archives --&gt;%n&lt;dl class=&quot;archives&quot;&gt;%n&lt;dt id=&quot;archivename&quot;&gt;Archives&lt;/dt&gt;%n&lt;dd id=&quot;archivelist&quot;&gt;{archives_list}&lt;/dd&gt;%n&lt;/dl&gt;%n&lt;!-- END archives --&gt;%n&lt;dl class=&quot;links&quot;&gt;%n&lt;dt id=&quot;linkname&quot;&gt;Links&lt;/dt&gt;%n&lt;dd id=&quot;linklist&quot;&gt;{link_list}&lt;/dd&gt;%n&lt;/dl&gt;%n&lt;dl class=&quot;profiles&quot;&gt;%n&lt;dt id=&quot;profilename&quot;&gt;Profile&lt;/dt&gt;%n&lt;dd id=&quot;profilelist&quot;&gt;{user_list}&lt;/dd&gt;%n&lt;/dl&gt;%n&lt;dl class=&quot;extra&quot;&gt;%n&lt;dt id=&quot;extraname&quot;&gt;Other&lt;/dt&gt;%n&lt;dd id=&quot;extralist&quot;&gt;%n&lt;ul&gt;%n&lt;li&gt;&lt;a href=&quot;{site_rss}&quot;&gt;RSS1.0&lt;/a&gt;&lt;/li&gt;%n&lt;li&gt;&lt;a href=&quot;{site_atom}&quot;&gt;Atom0.3&lt;/a&gt;&lt;/li&gt;%n&lt;li&gt;Powered by &lt;a href=&quot;http://serennz.cool.ne.jp/sblog/&quot;&gt;&lt;strong&gt;sb&lt;/strong&gt;&lt;/a&gt;&lt;/li&gt;%n&lt;/ul&gt;%n&lt;/dd&gt;%n&lt;/dl&gt;%n&lt;form method=&quot;get&quot; action=&quot;{site_cgi}&quot;&gt;%n&lt;dl class=&quot;search&quot;&gt;%n&lt;dt&gt;Search this site&lt;/dt&gt;%n&lt;dd&gt;%n&lt;input id=&quot;search&quot; name=&quot;search&quot; size=&quot;16&quot; class=&quot;form&quot; /&gt;%n&lt;input type=&quot;submit&quot; value=&quot;Search&quot; class=&quot;button&quot; /&gt;%n&lt;/dd&gt;%n&lt;/dl&gt;%n&lt;/form&gt;%n&lt;/div&gt;&lt;!--_end_navigation_--&gt;%n&lt;hr /&gt;%n&lt;/div&gt;&lt;!--_end_body_--&gt;%n&lt;div class=&quot;footer&quot;&gt;%n&lt;address&gt;Copyright &amp;copy; 2004 SimpleBoxes. All Rights Reserved.&lt;/address&gt;%n&lt;p id=&quot;link2top&quot;&gt;&lt;a href=&quot;#top&quot;&gt;page top&lt;/a&gt;&lt;/p&gt;%n&lt;/div&gt;&lt;!--_end_footer_--&gt;%n{collect_log}%n&lt;/body&gt;%n&lt;/html&gt;<>/* reset elements */%nh1, h2, h3, h4, h5, h6 {%nposition: static;%nmargin: 0px;%npadding: 0px;%n}%ndiv, p, hr, blockquote, address, noscript {%nposition: static;%nmargin: 0px;%npadding: 0px;%nfont-style: normal;%nfont-weight: normal;%n}%nul, ol, dl, dt, dd {%nposition: static;%nmargin: 0px;%npadding: 0px;%n}%npre, table, form {%nposition: static;%nmargin: 0px;%npadding: 0px;%n}%nspan, img  {%nposition: static;%nmargin: 0px;%npadding: 0px;%nborder: none;%nfont-style: normal;%nfont-weight: normal;%nborder: 0px none #fafaff;%n}%nem, strong, q, dfn, code, samp, kbd, var, cite, abbr, acronym {%nposition: static;%nmargin: 0px;%npadding: 0px;%nborder: none;%nfont-style: normal;%nfont-weight: normal;%n}%n/* basic */%nbody {%nmargin: 0px;%npadding: 0px;%ncolor: #334;%nbackground-color: #fff;%n}%na {%ntext-decoration: underline;%n}%na:link {%ncolor: #66a;%n}%na:visited {%ncolor: #655;%n}%na:hover {%ncolor: #e50;%n}%na:active {%ncolor: #55c;%n}%nh2,h3,h4 {%nmargin: 0px;%npadding: 2px 10px 2px 10px;%nfont-family: &quot;Hiragino Kaku Gothic Pro&quot;,&quot;Osaka&quot;,sans-serif;%nline-height: 1.1em;%nfont-weight: bold;%nfont-size: 110%%;%ntext-align: left;%ncolor: #889;%nborder-bottom: 1px dotted #bbc;%n}%nh2 a {%ntext-decoration: none;%n}%nh2 a:link {%ncolor: #889;%n}%nh2 a:visited {%ncolor: #889;%n}%nh2 a:hover {%ncolor: #e50;%n}%nh2 a:active {%ncolor: #889;%n}%npre {%ndisplay: block;%nfont-family: monospace;%n}%nem {%nfont-family: &quot;Hiragino Kaku Gothic Pro&quot;,&quot;Osaka&quot;,&quot;Arial&quot;,sans-serif;%nfont-style: normal;%nfont-weight: normal;%nborder-bottom: 1px dashed #ccf;%n}%nstrong {%nfont-family: &quot;Hiragino Kaku Gothic Pro&quot;,&quot;Osaka&quot;,&quot;Arial&quot;,sans-serif;%nfont-weight: bold;%n}%nblockquote {%nmargin: 0px 20px 0px 20px;%npadding: 2px 8px 2px 8px;%ncolor: #77c;%nline-height: 1.4em;%nborder: 1px solid #ddf;%nbackground-color: #fafaff;%n}%nblockquote p {%npadding: 0px;%nmargin: 0px;%nfont-style: italic;%n}%np.source {%nmargin: 0px 20px 1em 20px;%npadding: 0px;%nfont-size: 90%%;%ntext-align: right;%n}%nq {%ncolor: #669;%nfont-style: italic;%n}%ncite {%nfont-style: normal;%n}%nul {%npadding-left: 2em;%n}%nol {%npadding-left: 2em;%n}%ndl dd {%npadding-left: 2em;%n}%ndel {%ntext-decoration: line-through;%n}%nins {%nborder-bottom: 1px dashed #cfc;%n}%n/* images */%nimg.pict {%n}%n/* title */%ndiv.title {%nmargin: 0px;%npadding: 0px;%ncolor: #fff;%nbackground-color: #bbd;%n}%ndiv.title h1 {%nmargin: 0px;%npadding: 10px 10px 5px 10px;%nfont-size: 130%%;%nfont-weight: bold;%nfont-family: &quot;Verdana&quot;,&quot;Osaka&quot;,sans-serif;%n}%ndiv.title h1 a {%ntext-decoration: none;%n}%ndiv.title h1 a:link {%ncolor: #fff;%n}%ndiv.title h1 a:visited {%ncolor: #fff;%n}%ndiv.title h1 a:hover {%ncolor: #fff;%n}%ndiv.title h1 a:active {%ncolor: #fff;%n}%ndiv.title p.description {%nmargin: 0px;%npadding: 0px 20px 10px 20px;%ncolor: #ddf;%nfont-size: 90%%;%n}%n/* footer */%ndiv.footer {%nmargin: 0px;%npadding: 0px;%ntext-align: center;%nfont-family: &quot;Verdana&quot;,sans-serif;%nfont-size: 11px;%n}%ndiv.footer a {%ntext-decoration: none;%n}%ndiv.footer address {%nmargin: 0px 20px 3px 0px;%n}%ndiv.footer p#link2top {%nmargin: 0px;%npadding: 10px 20px 10px 20px;%nfont-family: &quot;Verdana&quot;,sans-serif;%nfont-size: 10px;%ntext-align: right;%n}%ndiv.footer p#link2top:before {%ncontent: &quot;[&quot;;%n}%ndiv.footer p#link2top:after {%ncontent: &quot;]&quot;;%n}%n/* main */%ndiv.contents {%nwidth: 70%%;%nfloat: left;%nclear: left;%nbackground-color: #fff;%n}%ndiv.page {%nfont-size : 90%%;%ntext-align: center;%n}%ndiv.page a {%ntext-decoration: none;%n}%ndiv.body hr {%nclear: both;%nheight: 1px;%nmargin: 0px auto;%npadding: 0px;%ncolor: #fff;%nborder-style: none;%nborder-top: 1px solid #fff;%n}%n/* entry */%ndiv.entry {%nmargin: 10px 0px 10px 0px;%npadding: 0px 10px 0px 10px;%n}%ndiv.entry div.entry_author {%nmargin: 0px;%npadding: 2px 10px 2px 10px;%nfont-size: 90%%;%ntext-align: right;%n}%ndiv.entry div.entry_author a {%ntext-decoration: none;%n}%ndiv.entry div.entry_body {%nmargin: 0px;%npadding: 15px 20px 5px 20px;%nfont-size: 100%%;%nline-height: 1.4em;%ncolor: #445;%n}%ndiv.entry div.entry_more {%nmargin: 0px;%npadding: 5px 20px 15px 20px;%nfont-size: 100%%;%nline-height: 1.4em;%ncolor: #445;%n}%ndiv.entry div.entry_state {%nmargin: 0px;%npadding: 2px 10px 2px 10px;%nfont-size: 90%%;%ntext-align: right;%n}%ndiv.entry div.entry_state a {%ntext-decoration: none;%n}%ndiv.entry div.entry_navi {%nmargin: 0px;%npadding: 0px 10px 10px 10px;%nfont-size: 90%%;%ntext-align: center;%n}%ndiv.entry div.entry_navi a {%ntext-decoration: none;%n}%n/* comment */%ndiv.comment {%nmargin: 10px 0px 10px 0px;%npadding: 0px 10px 0px 40px;%n}%ndiv.comment form {%nmargin: 10px 0px;%npadding: 0px;%n}%ndiv.comment form dl {%nfont-size: 90%%;%n}%ndiv.comment form dl dt {%ndisplay: block;%nclear: left;%nfloat: left;%nwidth: 8em;%nmargin: 0px;%npadding: 0px;%nfont-family: &quot;Verdana&quot;,sans-serif;%ntext-align: right;%n}%ndiv.comment form dl dt label#labelsubmit {%ndisplay: none;%n}%ndiv.comment form dl dd {%nmargin: 0px 0px 0px 8.5em;%npadding: 0px;%n}%ndiv.comment dl.body {%nmargin: 0px;%npadding: 5px 5px 10px 5px;%nline-height: 1.3em;%nfont-size: 90%%;%n}%ndiv.comment dl.body dt {%nmargin: 0px;%npadding: 0px;%ncolor: #889;%ntext-align: right;%n}%n/* trackback */%ndiv.trackback {%nmargin: 10px 0px 10px 0px;%npadding: 0px 10px 0px 40px;%n}%ndiv.trackback p.link {%ntext-align: right;%nfont-size: 90%%;%n}%ndiv.trackback dl.body {%nmargin: 0px;%npadding: 5px 5px 10px 5px;%nline-height: 1.3em;%nfont-size: 90%%;%n}%ndiv.trackback dl.body dt {%nmargin: 0px;%npadding: 0px;%ncolor: #889;%ntext-align: right;%n}%n/* profile */%ndiv.profile {%nmargin: 10px 0px 10px 0px;%npadding: 0px 10px 0px 10px;%n}%ndiv.profile div.profile_body {%nmargin: 0px;%npadding: 15px 20px 5px 20px;%nfont-size: 100%%;%nline-height: 1.4em;%ncolor: #445;%n}%n/* navigation */%ndiv.navigation {%nmargin-left: 70%%;%npadding: 0px 15px 0px 15px;%nfont-size: 90%%;%n}%n/* links */%ndiv.navigation dl {%nmargin: 15px 0px 15px 0px;%npadding: 0px;%n}%ndiv.navigation dl dt {%nmargin: 0px;%npadding: 2px 5px 2px 5px;%nfont-family: &quot;Verdana&quot;,sans-serif;%nfont-weight: bold;%ncolor: #99a;%nborder-top: 2px solid #bbc;%nborder-bottom: 2px solid #bbc;%nbackground-color: #fafaff;%n}%ndiv.navigation dl dd {%nmargin: 0px;%npadding: 0px;%n}%ndiv.navigation dl dd ul {%nlist-style: none;%nmargin: 0px;%npadding: 0px;%n}%ndiv.navigation dl dd ul li {%ndisplay: block;%nmargin: 0px;%npadding: 2px 0px 2px 10px;%nfont-size: 90%%;%ncolor: #668;%nborder-bottom: 1px solid #ccd;%nbackground-color: #fafaff;%n}%ndiv.navigation dl dd ul li li {%nborder-top: 1px dashed #ccd;%nborder-bottom: 0px none #fafaff;%n}%ndiv.navigation dl dd ul li a {%ntext-decoration: none;%n}%ndiv.navigation dl.extra dt {%ndisplay: none;%n}%ndiv.navigation dl.extra ul {%nmargin: 0px;%npadding: 0px;%nlist-style: none;%ntext-align: center;%n}%ndiv.navigation dl.extra a {%ntext-decoration: none;%n}%ndiv.navigation dl.extra li {%npadding: 3px 0px 3px 0px;%nline-height: 1.3em;%nfont-family: &quot;Verdana&quot;,sans-serif;%ncolor: #668;%nborder-bottom: 1px none #ccd;%nbackground-color: transparent;%n}%ndiv.navigation dl.search {%nmargin: 10px 0px 10px 0px;%npadding: 0px;%ntext-align: center;%n}%ndiv.navigation dl.search dt {%nfont-family: &quot;Verdana&quot;,sans-serif;%n}%n/* calendar */%ndiv.navigation dl.calendar {%nbackground-color: #fafaff;%nborder-bottom: 1px solid #ccd;%n}%ndiv.navigation dl.calendar dd {%nmargin: 0px;%npadding: 0px;%ntext-align: center;%nbackground-color: #fafaff;%n}%ndiv.navigation dl.calendar dd table {%nwidth: 180px;%nmargin: 0px;%nmargin-left: auto;%nmargin-right: auto;%npadding: 0px;%nborder: 0px none;%nborder-color: #ccc #333 #333 #ccc;%nbackground-color: #fafaff;%n}%ndiv.navigation dl.calendar dd table td.cell {%npadding: 1px;%nfont-family: &quot;Verdana&quot;,sans-serif;%nfont-size: 10px;%nline-height: 170%%;%ncolor: #bbc;%ntext-align: center;%n}%ndiv.navigation dl.calendar dd table td.weekday {%npadding: 1px;%nfont-family: mono-space;%nfont-size: 10px;%nline-height: 170%%;%ncolor: #bbc;%ntext-align: center;%n}%ndiv.navigation dl.calendar dd table td.cell a {%nmargin: -1px;%npadding: 1px;%ntext-decoration: none;%nfont-weight: bold;%ndisplay: block;%n}%ndiv.navigation div.calendar table td.cell span.today {%ncolor: #b99;%n}%ndiv.navigation div.calendar table td.cell a span.today {%nfont-weight: bold;%n}%ndiv.navigation dl.calendar dd td.calendar_month {%nfont-family: &quot;Verdana&quot;,sans-serif;%nfont-size: 10px;%ntext-align: center;%n}%ndiv.navigation dl.calendar dd td.calendar_month a {%ntext-decoration: none;%n}<><><>
