<?xml version="1.0" encoding="{feed_site_encoding}"?>
<rdf:RDF
	xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
	xmlns="http://purl.org/rss/1.0/"
	xmlns:dc="http://purl.org/dc/elements/1.1/"
	xmlns:content="http://purl.org/rss/1.0/modules/content/"
	xmlns:cc="http://web.resource.org/cc/"
	xml:lang="{site_lang}">
	<channel rdf:about="{feed_url}">
		<!-- BEGIN title -->
		<title>{site_title}</title>
		<link>{site_top}</link>
		<description><![CDATA[{blog_description}]]></description>
		<dc:language>{site_lang}</dc:language>
		<!-- END title -->
		<items>
			<rdf:Seq>
			<!-- BEGIN feed_entrylist -->
			<rdf:li rdf:resource="{feed_list_url}" />
			<!-- END feed_entrylist -->
			</rdf:Seq>
		</items>
	</channel>
	<!-- BEGIN feed_entry -->
	<item rdf:about="{feed_entry_url}">
		<link>{feed_entry_url}</link>
		<title>{feed_entry_title}</title>
		<description>{feed_entry_summary}</description>
		<content:encoded><![CDATA[{feed_entry_description}]]></content:encoded>
		<dc:subject>{feed_entry_category}</dc:subject>
		<dc:date>{feed_entry_date}</dc:date>
		<dc:creator>{feed_entry_author}</dc:creator>
		<dc:publisher>{product_name}</dc:publisher>
		<dc:rights>{feed_entry_author}</dc:rights>
	</item>
  <!-- END feed_entry -->
</rdf:RDF>
